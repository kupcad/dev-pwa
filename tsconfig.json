{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "checkJs": true,
    // @kupcad/* are JavaScript typed by JSDoc, without declaration files: their types are read
    // from their sources, as deep as their own imports go
    "maxNodeModuleJsDepth": 4
  },
  "include": [".astro/types.d.ts", "**/*"],
  "exclude": ["dist", "worker"]
}
